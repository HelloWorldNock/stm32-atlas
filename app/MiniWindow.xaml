<Window x:Class="Stm32Atlas.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Library Atlas · Mini"
        Width="432" SizeToContent="Height" MaxHeight="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="Manual" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="MiniRow" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="6,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bg" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource MiniHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource MiniSelect}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MiniIconButton" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Foreground" Value="{DynamicResource MiniMuted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" CornerRadius="6" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource MiniHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MiniScroll" TargetType="ScrollBar">
            <Setter Property="Width" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent" Margin="1,2">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border CornerRadius="3" Background="{DynamicResource MiniScrollThumb}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="MiniSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="track" CornerRadius="9" Background="{DynamicResource MiniLine}" />
                            <Ellipse x:Name="knob" Width="14" Height="14" Margin="2" HorizontalAlignment="Left"
                                     Fill="{DynamicResource MiniBg}" Stroke="{DynamicResource MiniLine}" StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource MiniAccent}" />
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="knob" Property="Stroke" Value="{DynamicResource MiniAccent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MiniSlider" TargetType="Slider">
            <Setter Property="Height" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource MiniLine}" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="12" Height="12" Fill="{DynamicResource MiniAccent}" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Shell" Margin="14" CornerRadius="14" BorderThickness="1"
            Background="{DynamicResource MiniBg}" BorderBrush="{DynamicResource MiniLine}"
            MouseLeftButtonDown="Shell_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.24" Color="#0F172A" />
        </Border.Effect>

        <StackPanel>
            <!-- header -->
            <Grid Margin="12,9,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Grid Width="16" Height="16" VerticalAlignment="Center">
                    <Border CornerRadius="5" Background="{DynamicResource MiniAccent}" Opacity="0.16" />
                    <Path Data="M5,5 H11 V11 H5 Z" Stroke="{DynamicResource MiniAccent}" StrokeThickness="1.3"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>

                <TextBlock x:Name="HeadText" Grid.Column="1" Text="迷你查询" Margin="8,0,0,0"
                           FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"
                           Foreground="{DynamicResource MiniText}" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="SettingsButton" Style="{StaticResource MiniIconButton}" Click="Settings_Click" ToolTip="窗口设置">
                        <Grid Width="13" Height="13">
                            <Path Data="M1,4.2 H12 M1,9.4 H12"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            <Path Data="M3.5,2.4 A1.4,1.4 0 1 0 3.5,5.2 A1.4,1.4 0 1 0 3.5,2.4 M8.5,7.6 A1.4,1.4 0 1 0 8.5,10.4 A1.4,1.4 0 1 0 8.5,7.6"
                                  Fill="{DynamicResource MiniBg}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" />
                        </Grid>
                    </Button>
                    <Button x:Name="WatchButton" Style="{StaticResource MiniIconButton}" Click="Watch_Click" ToolTip="划词监听">
                        <Path Data="M2.5,6.5 C4.5,3.5 7,2 9.5,2 C12,2 14.5,3.5 16.5,6.5 C14.5,9.5 12,11 9.5,11 C7,11 4.5,9.5 2.5,6.5 Z M9.5,4.5 A2,2 0 1 0 9.5,8.5 A2,2 0 1 0 9.5,4.5 Z"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" />
                    </Button>
                    <Button Style="{StaticResource MiniIconButton}" Click="Close_Click" ToolTip="关闭（Esc）">
                        <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- settings -->
            <Border x:Name="SettingsPanel" Margin="12,2,12,8" CornerRadius="9" BorderThickness="1"
                    Background="{DynamicResource MiniFieldBg}" BorderBrush="{DynamicResource MiniLine}"
                    Visibility="Collapsed">
                <StackPanel Margin="10,7,10,9">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="TopLabel" Text="窗口置顶" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MiniText}" />
                        <ToggleButton x:Name="TopToggle" Grid.Column="1" Style="{StaticResource MiniSwitch}"
                                      Checked="TopToggle_Changed" Unchecked="TopToggle_Changed" />
                    </Grid>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="OpacityLabel" Text="不透明度" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MiniText}" />
                        <Slider x:Name="OpacitySlider" Grid.Column="1" Margin="10,0,8,0" Minimum="40" Maximum="100"
                                Value="100" IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                Style="{StaticResource MiniSlider}" ValueChanged="Opacity_Changed" />
                        <TextBlock x:Name="OpacityValue" Grid.Column="2" Text="100%" FontSize="11" Width="32"
                                   TextAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource MiniMuted}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- search box -->
            <Border Margin="12,2,12,8" CornerRadius="9" BorderThickness="1"
                    Background="{DynamicResource MiniFieldBg}" BorderBrush="{DynamicResource MiniLine}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Grid.Column="0" Margin="10,0,0,0" VerticalAlignment="Center"
                          Data="M1,1 A5.2,5.2 0 1 0 11,1 A5.2,5.2 0 1 0 1,1 M9.6,9.6 L13.4,13.4"
                          Stroke="{DynamicResource MiniMuted}" StrokeThickness="1.3"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <TextBox x:Name="Query" Grid.Column="1" BorderThickness="0" Background="Transparent"
                             Margin="8,0,10,0" Padding="0,8" FontSize="12.5"
                             Foreground="{DynamicResource MiniText}" CaretBrush="{DynamicResource MiniText}"
                             TextChanged="Query_TextChanged" KeyDown="Query_KeyDown" />
                </Grid>
            </Border>

            <ListBox x:Name="Results" Margin="6,0,6,2" BorderThickness="0" Background="Transparent"
                     MaxHeight="330" ItemContainerStyle="{StaticResource MiniRow}"
                     Foreground="{DynamicResource MiniText}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     MouseLeftButtonUp="Results_MouseLeftButtonUp">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar" BasedOn="{StaticResource MiniScroll}" />
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Sub}" FontSize="11" Opacity="0.62" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="Hint" Margin="14,2,14,10" FontSize="10.5" Opacity="0.55"
                       Foreground="{DynamicResource MiniMuted}" TextWrapping="Wrap" />
        </StackPanel>
    </Border>
</Window>
